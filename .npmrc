# Supply-chain hardening. Applies to every npm command run in this repo (local, CI and Docker).

# Pin exact versions when adding dependencies.
save-exact=true

# Only install versions published at least 7 days ago. Dependabot uses the same cooldown.
min-release-age=7

# Never run dependency install scripts (preinstall, install, postinstall).
# Everything we use ships prebuilt binaries; `npm run <script>` still works.
ignore-scripts=true

# Only registry packages: no git or remote tarball dependencies.
allow-git=none
allow-remote=none

# Refuse to install with the wrong Node or npm version (see engines and devEngines).
engine-strict=true

fund=false
update-notifier=false
audit-level=high
