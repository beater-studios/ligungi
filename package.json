{
  "name": "ligungi",
  "version": "0.1.3",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "homepage": "https://ligungi.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beater-studios/ligungi.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.22.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0",
      "onFail": "error"
    }
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @ligungi/web",
    "start": "STATIC_DIR=../web/dist npm run start -w @ligungi/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
